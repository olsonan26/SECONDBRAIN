{
  "name": "secondbrain",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "import:brain": "node --import tsx scripts/import-brain.ts",
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "publish:library": "node --env-file=.env.local --import tsx scripts/publish-library.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@vercel/blob": "2.8.2",
    "iron-session": "9.0.1",
    "lucide-react": "1.59.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
